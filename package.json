{
  "name": "@walma-labs/shopify-mcp",
  "version": "0.2.0",
  "description": "Shopify Admin MCP server for one store: shop, products, orders, ShopifyQL analytics and any read query of the Admin GraphQL API, read-only by default with an opt-in tool for an allowlist of mutations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walma-Labs/shopify-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shopify-mcp": "dist/stdio.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "graphql": "^16.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
